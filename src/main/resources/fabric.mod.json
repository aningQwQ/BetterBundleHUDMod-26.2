{
    "schemaVersion": 1,
    "id": "better-bundle",
    "version": "${version}",
    "name": "Better Bundle",
    "description": "Adds a side panel to the inventory for quick bundle access",
    "authors": [],
    "contact": {},
    "license": "GPL-3.0-only",
    "environment": "client",
    "entrypoints": {
        "client": [
            "betterbundle.BetterBundleMod"
        ],
        "modmenu": [
            "betterbundle.config.ModMenuIntegration"
        ]
    },
    "accessWidener": "better-bundle.accesswidener",
    "mixins": [
        {
            "config": "better-bundle.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "${minecraft_range}",
        "java": ">=25",
        "cloth-config": ">=${cloth_config_version}"
    },
    "suggests": {
        "modmenu": "*"
    }
}
